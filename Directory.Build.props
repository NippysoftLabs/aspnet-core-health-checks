<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Source paths in stack traces start at the repo root, not at a local folder. -->
    <PathMap>$(MSBuildThisFileDirectory)=/repo/</PathMap>
  </PropertyGroup>
</Project>
