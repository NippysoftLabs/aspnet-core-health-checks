{
  "Kestrel": {
    "Endpoints": {
      "Public": { "Url": "http://+:8080" },
      "Management": { "Url": "http://localhost:8081" }
    }
  },
  "Management": { "Port": 8081 },
  "Orders": { "DatabasePath": "data/orders.db", "CheckTimeoutMs": 800 },
  "Payments": { "BaseUrl": "http://localhost:5399/", "CacheSeconds": 10, "CheckTimeoutMs": 800 },
  "Startup": { "WarmUpSeconds": 5 },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.HealthChecks": "Warning",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  }
}
